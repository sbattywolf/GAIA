# GAIA Engineering Loop Configuration
# This file contains default configuration for the engineering loop

# Default maximum number of loops before escalation
MAX_LOOPS=5

# Default target mode (physical or simulated)
TARGET_MODE=physical

# Default loop ID - will be overridden by script
LOOP_ID=""

# Default branch to work with
BRANCH="ING_3090"

# Default runner script path
RUNNER="gaia_1070_physical_validation/run_1070_validation.sh"

# Default validation target
VALIDATION_TARGET="1070"

# Default remote
REMOTE="origin"

# Whether to push evidence (0 = no, 1 = yes)
PUSH_EVIDENCE=0