services:
  gaia-3090-ollama:
    image: ollama/ollama:0.33.1@sha256:075246f72d4109385b4a01c3ac8e9cbd26a0bcb21cd7aa30edbccd24e1b3180c
    container_name: gaia-3090-ollama
    volumes:
      - ollama-data:/root/.ollama
    environment:
      - OLLAMA_HOST=0.0.0.0
      - OLLAMA_KEEP_ALIVE=5m
    networks:
      - gaia-3090-model-stack
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 30s
      timeout: 10s
      retries: 3

  gaia-3090-openclaw:
    image: openclaw/openclaw:2026.7.1@sha256:6a31d44b2944e7adcd2b582bf6fb463111264ebca97a0201795b799135bd102c
    container_name: gaia-3090-openclaw
    command:
      [
        "openclaw",
        "node",
        "run",
        "--host",
        "10.16.20.13",
        "--port",
        "18789",
        "--display-name",
        "GAIA-3090"
      ]
    environment:
      HOME: /home/node
      OPENCLAW_HOME: /home/node
      OPENCLAW_STATE_DIR: /home/node/.openclaw
      OPENCLAW_CONFIG_PATH: /home/node/.openclaw/openclaw.json
      OPENCLAW_CONFIG_DIR: /home/node/.openclaw
      OPENCLAW_WORKSPACE_DIR: /home/node/.openclaw/workspace
      OPENCLAW_GATEWAY_TOKEN: ${OPENCLAW_GATEWAY_TOKEN}
    volumes:
      - openclaw-data:/home/node/.openclaw
    networks:
      - gaia-3090-model-stack
    depends_on:
      gaia-3090-ollama:
        condition: service_healthy
    restart: unless-stopped
    init: true
    healthcheck:
      disable: true

volumes:
  ollama-data:
  openclaw-data:
  opencode-data:

networks:
  gaia-3090-model-stack:
    driver: bridge

services:
  gaia-3090-opencode:
    image: ghcr.io/anomalyco/opencode:1.18.25
    user: 1000:1000
    environment:
      - HOME=/home/opencode
      - OPENCODE_CONFIG_DIR=/home/opencode/.config/opencode
      - OPENCODE_STATE_DIR=/home/opencode/.local/share/opencode
      - OPENCODE_WORKSPACE_DIR=/workspace/gaia
    volumes:
      - /mnt/gaia-storage/gaia/3090/opencode/config:/home/opencode/.config/opencode
      - /mnt/gaia-storage/gaia/3090/opencode/state:/home/opencode/.local/share/opencode
      - /mnt/gaia-storage/gaia/3090/opencode/logs:/home/opencode/.local/share/opencode/logs
      - /mnt/gaia-storage/gaia/3090/opencode/workspace:/workspace/gaia
      - /home/sbatta/github_repos/GAIA:/workspace/gaia:ro
    working_dir: /workspace/gaia
    networks:
      - gaia-3090-model-stack
    depends_on:
      gaia-3090-ollama:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "sh", "-c", "opencode --version"]
      interval: 30s
      timeout: 10s
      retries: 3
