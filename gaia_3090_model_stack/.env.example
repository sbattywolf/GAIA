# GAIA 3090 Model Serving Stack - Environment Variables
#
# This file contains placeholders for environment variables needed
# by the canonical 3090 model-serving stack.
#
# To use this configuration:
# 1. Copy this file to .env
# 2. Fill in the actual values for secrets
# 3. Run: docker compose -f compose.yaml up

# Open WebUI Secret Key (required)
WEBUI_SECRET_KEY=<set-locally>

# Ollama Base URL (automatically set by compose, but can be overridden)
OLLAMA_BASE_URL=http://gaia-3090-ollama:11434

# For debugging or custom configuration
# OLLAMA_HOST=0.0.0.0
# OLLAMA_KEEP_ALIVE=5m
