[Unit]
Description=Framework Local-AI - Telegram Command & Speech Agent
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=sbatta
WorkingDirectory=/home/sbatta/local-ai/Scripts
ExecStart=/usr/bin/python3 /home/sbatta/local-ai/Scripts/msi_1070/telegram_agent.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
