# PM-002 bounded local configuration example.
# Keep real values outside the repository.
HOME_ASSISTANT_BASE_URL=https://<local-home-assistant-host>
# HOME_ASSISTANT_TOKEN is supplied only through ~/.config/gaia/.secrets.env
GAIA_PM002_ENTITY_ID=light.living_room
# Optional freshness threshold in seconds. Empty means source freshness is accepted.
GAIA_PM002_MAX_AGE_SECONDS=
