[Unit]
Description=ZEUS Edge
After=network-online.target
[Service]
User=sbatta
WorkingDirectory=/home/sbatta/github_repos/home_assistant_framework/1070
EnvironmentFile=/home/sbatta/github_repos/home_assistant_framework/1070/.env
EnvironmentFile=/home/sbatta/github_repos/home_assistant_framework/1070/.secrets.env
ExecStart=/home/sbatta/github_repos/home_assistant_framework/.venv/bin/python app/telegram_agent.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
